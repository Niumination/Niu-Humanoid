  {
   "file": "shaders/apex/01-vert-8504b-aU.glsl",
   "category": "APP",
   "bytes": 8570,
   "uniforms": [
    "uAttn",
    "uBoilT, uVeinT, uWaveT, uBoilAmp, uPivotY",
    "uClick",
    "uPalCyan, uPalPale",
    "uStateA, uStateB, uBloomR",
    "uStrongMix, uEnergy, uRim",
    "uYaw, uPitch, uBreathe, uBreathY, uBackK, uVein, uSize, uPixelRatio"
   ],
   "attributes": [
    "aBoil",
    "aBright",
